# Template for a local .env. On the server use deploy/staging.env.example or
# deploy/production.env.example instead. Never commit the real .env.
COMPOSE_PROJECT_NAME=qonnect-smarthouse
APP_BIND=127.0.0.1
APP_PORT=8090

POSTGRES_DB=smarthouse
POSTGRES_USER=smarthouse
# Generate on the server:  openssl rand -hex 32   (URL-safe; no $ or quotes)
POSTGRES_PASSWORD=

# Set to https://<your-subdomain> once the Caddy route exists; blank until then.
APP_ORIGIN=
COOKIE_SECURE=true
TRUST_PROXY=1
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=15
APP_TIMEZONE=Asia/Qatar
MIGRATE_ON_START=false
APP_TAG=latest

# ---- Web Push notifications (optional). Leave blank to keep push off; alerts still show in the app.
# Generate a key pair ON THE SERVER (use different keys for staging and production):
#   docker compose run --rm --no-deps app node dist-server/generate-vapid-keys.js
# Keep VAPID_PRIVATE_KEY secret. Changing the keys later means every device has to re-enable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address you monitor, e.g. mailto:ops@your-domain
VAPID_SUBJECT=
# Extra push-service hosts to allow (comma-separated); the major browser services are allowed by default.
PUSH_ALLOWED_HOSTS=
# Hourly due-soon / overdue checks (true/false). Defaults to on.
NOTIFY_SCHEDULER=true

# ---- Local development only (npm run dev); not used by Docker Compose
# DATABASE_URL=postgres://smarthouse:<password>@localhost:5432/smarthouse_dev
# UPLOAD_DIR=./data/uploads
# COOKIE_SECURE=false
