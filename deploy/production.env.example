# PRODUCTION stack — copy to <APP_DIR>/.env on the server and fill in the password there.
# Never commit the real .env. Use a different password from staging.
COMPOSE_PROJECT_NAME=qonnect-smarthouse
APP_BIND=127.0.0.1
APP_PORT=8090

POSTGRES_DB=smarthouse
POSTGRES_USER=smarthouse
# Generate on the server:  openssl rand -hex 32   (URL-safe; no $ or quotes)
POSTGRES_PASSWORD=

# Set to https://<your-subdomain> once the Caddy route exists; blank until then.
APP_ORIGIN=
COOKIE_SECURE=true
TRUST_PROXY=1
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=15
APP_TIMEZONE=Asia/Qatar
MIGRATE_ON_START=false
APP_TAG=latest
